@@ -4,8 +4,91 @@
 
 #include "content/public/browser/media_stream_request.h"
 
+#include <utility>
+
 namespace content {
 
+SolaraCaptureControl::SolaraCaptureControl(
+    base::OnceCallback<void(bool)> stop)
+    : stop_(std::move(stop)) {}
+
+SolaraCaptureControl::~SolaraCaptureControl() = default;
+
+void SolaraCaptureControl::SetChangeCallback(base::RepeatingClosure changed) {
+  base::AutoLock lock(lock_);
+  changed_ = std::move(changed);
+}
+
+void SolaraCaptureControl::Cancel() {
+  base::OnceCallback<void(bool)> stop;
+  base::RepeatingClosure changed;
+  bool was_active;
+  {
+    base::AutoLock lock(lock_);
+    if (state_ == State::kEnded) {
+      return;
+    }
+    was_active = state_ == State::kActive;
+    state_ = State::kEnded;
+    stop = std::move(stop_);
+    changed = changed_;
+  }
+  if (stop) {
+    std::move(stop).Run(was_active);
+  }
+  if (changed) {
+    changed.Run();
+  }
+}
+
+void SolaraCaptureControl::End() {
+  base::RepeatingClosure changed;
+  {
+    base::AutoLock lock(lock_);
+    if (state_ == State::kEnded) {
+      return;
+    }
+    state_ = State::kEnded;
+    stop_.Reset();
+    changed = changed_;
+  }
+  if (changed) {
+    changed.Run();
+  }
+}
+
+bool SolaraCaptureControl::CommitStart(base::OnceClosure start) {
+  base::RepeatingClosure changed;
+  {
+    base::AutoLock lock(lock_);
+    if (state_ != State::kStarting) {
+      return false;
+    }
+    state_ = State::kActive;
+    std::move(start).Run();
+    changed = changed_;
+  }
+  if (changed) {
+    changed.Run();
+  }
+  return true;
+}
+
+void SolaraCaptureControl::HoldStartForTesting() {
+  base::AutoLock lock(lock_);
+  waiting_for_start_ = true;
+}
+
+bool SolaraCaptureControl::IsWaitingForStartForTesting() const {
+  base::AutoLock lock(lock_);
+  return state_ == State::kStarting && waiting_for_start_;
+}
+
+SolaraCaptureControl::State SolaraCaptureControl::state() const {
+  base::AutoLock lock(lock_);
+  return state_;
+}
