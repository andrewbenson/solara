+bool IsSolaraGoogleMapsURL(const GURL& url) {
+  if (!url.SchemeIs(url::kHttpsScheme) || url.EffectiveIntPort() != 443 ||
+      (url.path() != "/maps" && !url.path().starts_with("/maps/"))) {
+    return false;
+  }
+
+  std::string_view host = url.host();
+  if (host.starts_with("www.")) {
+    host.remove_prefix(4);
+  }
+  return std::ranges::contains(google_util::GetGoogleRegistrableDomains(), host);
+}
