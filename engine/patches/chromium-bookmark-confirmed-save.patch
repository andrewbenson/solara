+void BookmarkStorage::SaveNow(base::OnceCallback<void(bool)> completion) {
+  base::DictValue value = EncodeModelToDict(model_, permanent_node_selection_);
+  ScheduleSave();
+  writer_.DoScheduledWrite();
+  auto save = base::BindOnce(
+      [](base::DictValue value,
+         scoped_refptr<const os_crypt_async::Encryptor> encryptor,
+         StorageFileEncryptionType primary_encryption_type,
+         base::FilePath primary_path, base::FilePath secondary_path,
+         bool write_secondary,
+         std::shared_ptr<std::atomic<uint64_t>> save_generation,
+         uint64_t expected_generation,
+         base::OnceCallback<void(bool)> completion) {
+        if (save_generation->load() != expected_generation) {
+          return std::move(completion).Run(false);
+        }
+        std::string json_content;
+        if (!base::JSONWriter::WriteWithOptions(
+                value, base::JSONWriter::OPTIONS_PRETTY_PRINT, &json_content)) {
+          return std::move(completion).Run(false);
+        }
+        std::string encrypted_content;
+        if (primary_encryption_type == StorageFileEncryptionType::kEncrypted ||
+            write_secondary) {
+          if (!encryptor ||
+              !encryptor->EncryptString(json_content, &encrypted_content)) {
+            return std::move(completion).Run(false);
+          }
+        }
+        const bool primary_encrypted =
+            primary_encryption_type == StorageFileEncryptionType::kEncrypted;
+        auto write = [](const base::FilePath& path, const std::string& content,
+                        StorageFileEncryptionType encryption_type) {
+          std::string persisted;
+          return base::ImportantFileWriter::WriteFileAtomically(
+                     path, content, GetHistogramSuffix(encryption_type)) &&
+                 base::ReadFileToString(path, &persisted) && persisted == content;
+        };
+        bool saved = write(primary_path,
+                           primary_encrypted ? encrypted_content : json_content,
+                           primary_encryption_type);
+        if (write_secondary) {
+          saved = write(secondary_path,
+                        primary_encrypted ? json_content : encrypted_content,
+                        primary_encrypted ? StorageFileEncryptionType::kClearText
+                                          : StorageFileEncryptionType::kEncrypted) &&
+                  saved;
+        }
+        std::move(completion).Run(saved);
+      },
+      std::move(value), encryptor_, primary_file_encryption_type_, writer_.path(),
+      GetSecondaryFilePath(), ShouldWriteBookmarksToSecondaryFileOnDisk(),
+      save_generation_, save_generation_->load(),
+      base::BindPostTaskToCurrentDefault(std::move(completion)));
+  backend_task_runner_->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](scoped_refptr<base::SequencedTaskRunner> runner,
+             base::OnceClosure save) {
+            runner->PostTask(FROM_HERE, std::move(save));
+          },
+          backend_task_runner_, std::move(save)));
+}
