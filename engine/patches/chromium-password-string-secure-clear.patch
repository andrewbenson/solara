+void PasswordString::secure_clear() {
+  if (std::holds_alternative<crypto::ProcessBoundU16String>(value_)) {
+    std::get<crypto::ProcessBoundU16String>(value_).secure_clear();
+    return;
+  }
+
+  CHECK(std::holds_alternative<std::u16string>(value_));
+  std::u16string& plain_text = std::get<std::u16string>(value_);
+  crypto::SecureZeroBuffer(base::as_writable_byte_span(plain_text));
+  plain_text.clear();
+}
