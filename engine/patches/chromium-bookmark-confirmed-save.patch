+void BookmarkModel::SaveBookmarks(base::OnceCallback<void(bool)> completion) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!loaded_ || !local_or_syncable_store_) {
+    return std::move(completion).Run(false);
+  }
+  auto saved = base::BarrierCallback<bool>(
+      account_store_ ? 2 : 1,
+      base::BindOnce(
+          [](base::OnceCallback<void(bool)> completion, std::vector<bool> results) {
+            std::move(completion).Run(
+                std::ranges::all_of(results, [](bool success) { return success; }));
+          },
+          std::move(completion)));
+  local_or_syncable_store_->SaveNow(saved);
+  if (account_store_) {
+    account_store_->SaveNow(saved);
+  }
+}
