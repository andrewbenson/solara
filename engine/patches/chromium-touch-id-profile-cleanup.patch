   crypto::apple::ScopedFakeKeychainV2 keychain_{config_.keychain_access_group};
   TouchIdCredentialStore store_{config_};
 };
+
+TEST_F(CredentialStoreTest, DeleteCredentialsIsScopedAndIdempotent) {
+  const auto all_time = base::Time::Max();
+  EXPECT_TRUE(store_.DeleteCredentialsSync(base::Time(), all_time));
+  InsertCredentials(1);
+  InsertLegacyCredential(CredentialMetadata::Version::kV2, {7});
+  AuthenticatorConfig other_config = config_;
+  other_config.metadata_secret = "OtherTestMetadataSecret";
+  TouchIdCredentialStore other_store(other_config);
+  ASSERT_TRUE(other_store.CreateCredential(
+      kRpId, kUser, TouchIdCredentialStore::kDiscoverable));
+  ASSERT_EQ(store_.CountCredentialsSync(base::Time(), all_time), 2u);
+  ASSERT_EQ(other_store.CountCredentialsSync(base::Time(), all_time), 1u);
+
+  EXPECT_TRUE(store_.DeleteCredentialsSync(base::Time(), all_time));
+  EXPECT_TRUE(store_.DeleteCredentialsSync(base::Time(), all_time));
+  EXPECT_EQ(store_.CountCredentialsSync(base::Time(), all_time), 0u);
+  EXPECT_EQ(other_store.CountCredentialsSync(base::Time(), all_time), 1u);
+  EXPECT_TRUE(other_store.DeleteCredentialsSync(base::Time(), all_time));
+  EXPECT_TRUE(other_store.DeleteCredentialsSync(base::Time(), all_time));
+}
 
