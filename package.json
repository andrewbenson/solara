{
  "name": "solara",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@solara/browser",
    "macos": "pnpm --filter @solara/browser macos",
    "pods": "pnpm --filter @solara/browser pods",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "shaders:check": "turbo run shaders:check",
    "test": "turbo run test && node --no-warnings --test extras/raycast-solara/src/scripts.test.ts scripts/lib/pods-sources.test.mjs apps/browser/scripts/perf/bench-hover.test.mjs apps/browser/scripts/perf/ratchet-locked.test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "turbo": "^2.11.3",
    "typescript": "~5.9.2"
  },
  "license": "Apache-2.0"
}
