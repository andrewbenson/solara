+class SolaraMapsCanvasNoiseBrowserTest
+    : public NavigationRequestBrowserTest_IsolateAllSites {
+ public:
+  SolaraMapsCanvasNoiseBrowserTest() {
+    features_.InitWithFeatures(
+        {blink::features::kHeliumNoise, blink::features::kHeliumNoiseCanvas,
+         blink::features::kHeliumNoiseAudio},
+        {});
+  }
+
+ protected:
+  static constexpr char kReadPixels[] = R"JS(
+    (canvas) => {
+      canvas.width = canvas.height = 32;
+      const ctx = canvas.getContext('2d', {willReadFrequently: true});
+      const pixels = ctx.createImageData(canvas.width, canvas.height);
+      for (let i = 0; i < pixels.data.length; i += 4) {
+        pixels.data[i] = ((i * 13) + 33) % 251;
+        pixels.data[i + 1] = ((i * 17) + 71) % 251;
+        pixels.data[i + 2] = ((i * 31) + 89) % 251;
+        pixels.data[i + 3] = 255;
+      }
+      ctx.putImageData(pixels, 0, 0);
+      return ctx.getImageData(0, 0, canvas.width, canvas.height).data
+          .some((byte, offset) => byte !== pixels.data[offset]);
+    }
+  )JS";
+
+  static bool ServeFixture(URLLoaderInterceptor::RequestParams* params) {
+    const GURL& url = params->url_request.url;
+    if (url.path() == "/canvas-worker.js") {
+      URLLoaderInterceptor::WriteResponse(
+          "HTTP/1.1 200 OK\nContent-Type: application/javascript\n\n",
+          JsReplace(R"JS(
+            const readPixels = () =>
+                (eval($1))(new OffscreenCanvas(32, 32));
+            if ('onconnect' in self) {
+              onconnect = event => event.ports[0].postMessage(readPixels());
+            } else if ('registration' in self) {
+              onmessage = event => event.ports[0].postMessage(readPixels());
+            } else {
+              postMessage(readPixels());
+            }
+          )JS", kReadPixels),
+          params->client.get(), std::nullopt, url);
+    } else {
+      URLLoaderInterceptor::WriteResponse(
+          "HTTP/1.1 200 OK\nContent-Type: text/html\n\n",
+          "<!doctype html><body></body>", params->client.get(), std::nullopt,
+          url);
+    }
+    return true;
+  }
+
+  EvalJsResult ReadDocumentCanvas(RenderFrameHost* frame) {
+    return EvalJs(frame, JsReplace(R"JS(
+      (eval($1))(document.createElement('canvas'))
+    )JS", kReadPixels));
+  }
+
+ private:
+  base::test::ScopedFeatureList features_;
+};
+
+IN_PROC_BROWSER_TEST_F(SolaraMapsCanvasNoiseBrowserTest, CommitURLScope) {
+  URLLoaderInterceptor interceptor(base::BindRepeating(&ServeFixture));
+  const char* exempt_urls[] = {
+      "https://www.google.com/maps",
+      "https://www.google.com/maps/dir/?q=test",
+      "https://www.google.co.uk/maps/",
+      "https://google.de/maps",
+  };
+  for (const char* url : exempt_urls) {
+    SCOPED_TRACE(url);
+    ASSERT_TRUE(NavigateToURL(shell(), GURL(url)));
+    EXPECT_EQ(false, ReadDocumentCanvas(
+                         shell()->web_contents()->GetPrimaryMainFrame()));
+  }
+  const char* noised_urls[] = {
+      "https://www.google.com/search?q=/maps",
+      "https://www.google.com/mapstuff",
+      "https://www.google.com/Maps",
+      "https://www.google.com:444/maps",
+      "https://a.google.com/maps",
+      "https://www.google.com.example.test/maps",
+      "https://www.google.off.ai.test/maps",
+      "http://www.google.com/maps",
+  };
+  for (const char* url : noised_urls) {
+    SCOPED_TRACE(url);
+    ASSERT_TRUE(NavigateToURL(shell(), GURL(url)));
+    EXPECT_EQ(true, ReadDocumentCanvas(
+                        shell()->web_contents()->GetPrimaryMainFrame()));
+  }
+}
+
+IN_PROC_BROWSER_TEST_F(SolaraMapsCanvasNoiseBrowserTest, FramesAndWorkers) {
+  URLLoaderInterceptor interceptor(base::BindRepeating(&ServeFixture));
+  ASSERT_TRUE(NavigateToURL(shell(), GURL("https://www.google.com/maps")));
+  auto* frame = shell()->web_contents()->GetPrimaryMainFrame();
+  EXPECT_EQ(false, ReadDocumentCanvas(frame));
+  EXPECT_EQ(true, EvalJs(frame, R"JS(
+    (async () => {
+      const context = new OfflineAudioContext(1, 1024, 44100);
+      const source = new ConstantSourceNode(context, {offset: 0.5});
+      source.connect(context.destination);
+      source.start();
+      const buffer = await context.startRendering();
+      return buffer.getChannelData(0).some(sample => sample !== 0.5);
+    })()
+  )JS"));
+  constexpr char kDedicatedWorker[] = R"JS(
+    new Promise(resolve => {
+      const worker = new Worker('/canvas-worker.js');
+      worker.onmessage = event => resolve(event.data);
+      worker.onerror = () => resolve('worker failed');
+    })
+  )JS";
+  EXPECT_EQ(false, EvalJs(frame, kDedicatedWorker));
+
+  constexpr char kSharedWorker[] = R"JS(
+    new Promise(resolve => {
+      const worker = new SharedWorker('/canvas-worker.js');
+      worker.port.onmessage = event => resolve(event.data);
+      worker.onerror = () => resolve('worker failed');
+    })
+  )JS";
+  EXPECT_EQ(true, EvalJs(frame, kSharedWorker));
+
+  EXPECT_EQ(true, EvalJs(frame, R"JS(
+    (async () => {
+      const registration =
+          await navigator.serviceWorker.register('/canvas-worker.js');
+      const {active} = await navigator.serviceWorker.ready;
+      const channel = new MessageChannel();
+      const response = new Promise(resolve => {
+        channel.port1.onmessage = event => resolve(event.data);
+      });
+      active.postMessage(null, [channel.port2]);
+      const result = await response;
+      await registration.unregister();
+      return result;
+    })()
+  )JS"));
+
+  for (const char* child_url : {"https://embed.google.com/maps",
+                                "https://third-party.test/maps",
+                                "https://www.google.com/maps"}) {
+    SCOPED_TRACE(child_url);
+    const int child_index = EvalJs(frame, JsReplace(R"JS(
+      new Promise(resolve => {
+        const iframe = document.createElement('iframe');
+        iframe.src = $1;
+        iframe.onload = () => resolve(window.length - 1);
+        document.body.append(iframe);
+      })
+    )JS", child_url)).ExtractInt();
+    auto* child = ChildFrameAt(frame, child_index);
+    ASSERT_TRUE(child);
+    ASSERT_EQ(GURL(child_url), child->GetLastCommittedURL());
+    EXPECT_EQ(true, ReadDocumentCanvas(child));
+    EXPECT_EQ(true, EvalJs(child, kDedicatedWorker));
+    if (child->GetLastCommittedOrigin() != frame->GetLastCommittedOrigin()) {
+      EXPECT_EQ(true, EvalJs(child, R"JS(
+        (() => {
+          try {
+            void parent.document;
+            return false;
+          } catch (error) {
+            return error.name === "SecurityError";
+          }
+        })()
+      )JS"));
+    }
+  }
+
+  ASSERT_TRUE(ExecJs(frame, "history.pushState({}, '', '/search');"));
+  EXPECT_EQ(false, ReadDocumentCanvas(frame));
+  ASSERT_TRUE(NavigateToURL(shell(), GURL("https://www.google.com/search?q=test")));
+  frame = shell()->web_contents()->GetPrimaryMainFrame();
+  EXPECT_EQ(true, ReadDocumentCanvas(frame));
+  EXPECT_EQ(true, EvalJs(frame, kDedicatedWorker));
+}
